{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.hoopcut.ai"
        }
      ],
      "destination": "https://hoopcut.ai/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/comments.js": {
      "maxDuration": 15,
      "includeFiles": "lib/{comment-videos.json,supabase-ca.crt}"
    },
    "api/analytics/events.js": {
      "maxDuration": 15
    },
    "api/shot-tracer/worker.js": {
      "maxDuration": 15
    },
    "api/shot-tracer.js": {
      "maxDuration": 15
    }
  },
  "installCommand": "npm ci"
}
